#--------------------------------------------------
# Ni for the quantum noise samples
#--------------------------------------------------
material:num-materials=1
#--------------------------------------------------
# Material 1: Nickel
#--------------------------------------------------
material[1]:material-name=Ni
material[1]:damping-constant=0.01
material[1]:exchange-matrix[1]=2.757e-21
material[1]:atomic-spin-moment=0.606 !muB
material[1]:uniaxial-anisotropy-constant=0.0
material[1]:material-element=Ni
# Lorentzian response of the open-system LLG (llg-quantum only), reduced units
# (1 = |gamma_e| x 1 T = 1.76e11 rad/s; 35.7 per THz)
material[1]:quantum-lorentzian-central-frequency=200.0
material[1]:quantum-lorentzian-width=150.0
